rules_version = '2';
// Website data (enquiries, rate-limit hashes) is written only by Cloud Functions using the
// Admin SDK, which bypasses these rules. No browser client ever needs direct access, so
// every client read and write is denied. Do not loosen without a security review.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
