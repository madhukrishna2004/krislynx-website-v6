# ---- Build-time (website) --------------------------------------------------
# Google Analytics 4 measurement ID. Leave empty to ship with no analytics at all.
# When set, GA loads only after a visitor accepts the cookie banner.
KX_GA_ID=

# ---- Local preview ----------------------------------------------------------
PORT=4173
# 1 = make the mock /api/* endpoints fail (to test error states)
KX_MOCK_FAIL=0

# ---- Cloud Functions (see functions/.env.example) ---------------------------
# Secrets are NOT set here. Use:
#   firebase functions:secrets:set RESEND_API_KEY
#   firebase functions:secrets:set IP_HASH_SALT
