{
  "name": "krislynx-website-functions",
  "private": true,
  "version": "1.0.0",
  "description": "Server endpoints for krislynx.com: /api/contact and /api/assistant",
  "type": "module",
  "main": "lib/index.cjs",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --outfile=lib/index.cjs --external:firebase-functions --external:firebase-admin",
    "serve": "npm run build && firebase emulators:start --only functions,hosting",
    "deploy": "firebase deploy --only functions:website"
  },
  "dependencies": {
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^6.0.1"
  },
  "devDependencies": {
    "esbuild": "0.27.7"
  }
}
